# MongoDB Atlas connection string. Set this in the PaaS environment/secrets.
# Use MONGODB_DIRECT_URI only if the host cannot resolve Atlas SRV records.
MONGODB_DIRECT_URI=
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE?retryWrites=true&w=majority

# Optional connection tuning
MONGODB_SERVER_SELECTION_TIMEOUT_MS=8000
MONGODB_CONNECT_TIMEOUT_MS=8000
MONGODB_SOCKET_TIMEOUT_MS=45000

# Authentication / email settings
JWT_SECRET=
EMAIL_FROM=
EMAIL_HOST=
EMAIL_PASSWORD=
EMAIL_PORT=587
EMAIL_USER=
FRONTEND_URL=
